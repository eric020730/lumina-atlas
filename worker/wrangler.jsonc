{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lumina-atlas-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "eric020730.com/beauty",
      "zone_name": "eric020730.com"
    },
    {
      "pattern": "eric020730.com/beauty/*",
      "zone_name": "eric020730.com"
    },
    {
      "pattern": "eric020730.com/lumina-atlas",
      "zone_name": "eric020730.com"
    },
    {
      "pattern": "eric020730.com/lumina-atlas/*",
      "zone_name": "eric020730.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
